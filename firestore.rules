rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin yetkisi kontrol fonksiyonu (admin@hantv.com ve kilicemre3437@gmail.com tam yetkilidir)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@hantv.com' ||
        request.auth.token.email == 'kilicemre3437@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Premium üyelik kontrol fonksiyonu (Yalnızca Premium üyeler ve Adminler senkronizasyon yapabilir)
    function isPremiumUser(userId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        (
          get(/databases/$(database)/documents/users/$(userId)).data.plan == 'premium' ||
          get(/databases/$(database)/documents/users/$(userId)).data.isPremium == true
        )
      );
    }

    // Kullanıcı profil ve cihaz kuralları
    match /users/{userId} {
      // Okuma: Admin tüm kullanıcıları okuyabilir, normal kullanıcı sadece kendini
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Oluşturma: Admin veya ilk üyelik
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Güncelleme: Admin her alanı güncelleyebilir.
      // Normal kullanıcı kendi cihazlarını (devices map) güncelleyebilir.
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || 
          (resource.data.role != null && request.resource.data.role == resource.data.role)))
      );

      // Silme: Admin veya kullanıcının kendisi
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // IPTV Kaynakları: Giriş yapan tüm kullanıcılar kendi IPTV kaynaklarını ekleyebilir, düzenleyebilir ve silebilir
      match /sources/{sourceId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Kategori & Kanal Özelleştirmeleri (Gizleme/Sıralama): Yalnızca Premium Üyeler ve Adminler
      match /sources/{sourceId}/config/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId && isPremiumUser(userId) || isAdmin());
      }

      // İlerleme Durumları (Kaldığı Yerden Devam Et): Giriş yapan tüm kullanıcılar kendi ilerlemesini kaydedebilir
      match /progress/{progressId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}

